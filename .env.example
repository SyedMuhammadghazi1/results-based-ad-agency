# -----------------------------------------------------------------------------
# Outcome Ads — environment variables. Copy to `.env` for local development.
# Every variable is validated at startup by src/env.ts (set SKIP_ENV_VALIDATION=1
# only for `next build` / CI steps that never talk to real services; a production
# server ignores it and fails fast on missing values).
# NEVER commit real secrets.
# -----------------------------------------------------------------------------

# --- Runtime -----------------------------------------------------------------
# NODE_ENV is set by the tooling (next dev → development, next start/Docker → production).
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Public base URL of the app (used for links in emails, webhook URLs, OAuth redirects, t.js).
APP_URL=http://localhost:3000
# Product name shown in the UI and emails (inlined at build time).
NEXT_PUBLIC_APP_NAME=Outcome Ads

# --- Database (PostgreSQL 16) ------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ad_agency_dev
# Max connections per app instance.
DATABASE_POOL_MAX=10
# "true" to require TLS to the database (managed Postgres such as Neon/RDS).
DATABASE_SSL=false
# Integration tests use this database (NEVER DATABASE_URL). Must end in _test.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/ad_agency_test

# --- Auth (Better Auth) ------------------------------------------------------
# >= 32 random chars: openssl rand -base64 48
BETTER_AUTH_SECRET=change-me-change-me-change-me-change-me-0000
# Defaults to APP_URL.
BETTER_AUTH_URL=

# --- Secrets at rest (AES-256-GCM) -------------------------------------------
# 32 random bytes, base64: openssl rand -base64 32
DATA_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
# Id written into every ciphertext envelope; change it when you rotate the key.
DATA_ENCRYPTION_KEY_ID=k1
# Old keys still allowed to DECRYPT during rotation: "k0:base64key,k00:base64key".
DATA_ENCRYPTION_PREVIOUS_KEYS=

# --- Background jobs ---------------------------------------------------------
# Bearer token required by POST/GET /api/cron/<job>. >= 16 chars.
CRON_SECRET=local-cron-secret-change-me

# --- Stripe (the agency's own account, for performance fees) -----------------
# Leave empty to run without billing (statements are still computed, no invoices).
STRIPE_SECRET_KEY=
# Signing secret of the /api/webhooks/stripe endpoint (whsec_...).
STRIPE_WEBHOOK_SECRET=
# stripe | test-bypass. test-bypass skips Stripe Checkout for the payment-method step
# and is IGNORED when NODE_ENV=production.
PAYMENTS_MODE=stripe

# --- Email -------------------------------------------------------------------
# Leave SMTP_HOST empty to log emails instead of sending (dev). Mailpit: localhost:1027.
SMTP_HOST=
SMTP_PORT=1027
SMTP_USER=
SMTP_PASSWORD=
# "true" for implicit TLS (port 465).
SMTP_SECURE=false
EMAIL_FROM=Outcome Ads <no-reply@localhost>
# Where operator alerts go. Empty = every operator/admin user.
OPERATOR_ALERT_EMAIL=

# --- Commercial defaults -----------------------------------------------------
# Default performance fee in basis points (1000 = 10%). Stored per agreement.
DEFAULT_FEE_RATE_BPS=1000
# Default click attribution window in days.
DEFAULT_ATTRIBUTION_WINDOW_DAYS=7
# Invoices unpaid this many days after issue pause the client's campaigns.
DUNNING_GRACE_DAYS=14

# --- Ad platforms ------------------------------------------------------------
# Connector used when a platform's API credentials are not configured:
# sandbox (deterministic fake, dev/demo) | manual (operators act in the platform UI).
# Use "manual" in production until real credentials are approved.
AD_CONNECTOR_FALLBACK=sandbox

# Meta Marketing API (requires App Review for ads_management / ads_read).
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v23.0

# Google Ads API (requires an approved developer token: Basic or Standard access).
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
# Manager (MCC) account id used as login-customer-id, digits only. Optional.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v21
