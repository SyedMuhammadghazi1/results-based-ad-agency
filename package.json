{
  "name": "results-based-ad-agency",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && npm run build:scripts",
    "build:scripts": "node scripts/build-scripts.mjs",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "db:studio": "drizzle-kit studio",
    "secrets:rotate": "tsx --env-file-if-exists=.env scripts/rotate-secrets.ts",
    "job:sync-spend": "tsx --env-file-if-exists=.env scripts/run-job.ts sync-spend",
    "job:budget-guard": "tsx --env-file-if-exists=.env scripts/run-job.ts budget-guard",
    "job:monthly-billing": "tsx --env-file-if-exists=.env scripts/run-job.ts monthly-billing",
    "job:dunning": "tsx --env-file-if-exists=.env scripts/run-job.ts dunning",
    "job:weekly-revenue-report": "tsx --env-file-if-exists=.env scripts/run-job.ts weekly-revenue-report",
    "job:cleanup": "tsx --env-file-if-exists=.env scripts/run-job.ts cleanup"
  },
  "dependencies": {
    "better-auth": "^1.7.6",
    "drizzle-orm": "^0.45.3",
    "next": "^16.3.6",
    "nodemailer": "^10.0.11",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "stripe": "^22.6.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "~1.56.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
